APP_NAME=the-bebot
APP_ENV=development

DISCORD_BOT_TOKEN=

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=the_bebot

LLM_BASE_URL=https://api.example.com/v1/chat/completions
LLM_API_KEY=your-api-key
LLM_MODEL=your-model

CONVERSATION_TIMEOUT=30s
MENTION_TIMEOUT=60s
MENTION_USER_COOLDOWN=5s
MAX_CONCURRENT_MENTIONS=8
MAX_CONTEXT_MESSAGES=15

MEMORY_ENABLED=true
MEMORY_MAX_RETRIEVED_MEMORIES=5

MEMORY_WORKER_COUNT=2

# Optional global Personality overrides (leave empty to use defaults)
PERSONALITY_NAME=
PERSONALITY_EXTRA_TRAITS=
PERSONALITY_LANGUAGE_POLICY=

LOG_LEVEL=info
